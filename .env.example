NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=

# Required only for CLI E2E cleanup.
# Use a non-production Supabase database connection string.
E2E_DATABASE_URL=

# Explicit opt-in for destructive remote cleanup.
E2E_ALLOW_REMOTE_CLEANUP=false

# Exact Supabase project ref expected by the cleanup command.
E2E_CLEANUP_PROJECT_REF=
